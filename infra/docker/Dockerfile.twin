# Build the signal-timing twin (services/twin): a cell-transmission model of
# the city's road network that tests every AI signal proposal against doing
# nothing before an officer sees it. It never changes a signal.
# Build context: the REPO ROOT (compose: context .., dockerfile
# infra/docker/Dockerfile.twin; the root .dockerignore keeps venvs, caches and
# node_modules out). The image takes the service's pyproject.toml and src/,
# and the City Pack folder cities/ whose network.json the twin runs on
# (OpenStreetMap-derived, ODbL; generated, read-only).
# Dependencies come entirely from services/twin/pyproject.toml.
# Base and tool images are pinned by digest (python 3.12.15-slim, uv 0.13.5) so a
# rebuild is reproducible; bump them deliberately, never by a floating tag.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS base

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv

WORKDIR /app
COPY services/twin/pyproject.toml ./

RUN uv pip install --system --no-cache -r pyproject.toml

COPY services/twin/src/ src/
COPY cities/ cities/

# COPY keeps the checkout's mode bits and POSIX ACLs (0640/2750 on this
# host); make the sources world-readable for the non-root runtime user
# (uid 10008; the emulator is 10002, osint-ingress 10003, the oracle 10004).
RUN chmod -R a+rX /app \
 && useradd --system --uid 10008 --no-create-home twin
USER twin

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV SAHOSHI_TWIN_NETWORK=/app/cities/kolkata/network.json
# Binds 127.0.0.1:8198 by default (config.py; SAHOSHI_TWIN_HOST/PORT override).
EXPOSE 8198
CMD ["python", "-m", "sahoshi_twin"]
