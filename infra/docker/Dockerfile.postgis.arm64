# VVIP PostGIS image — arm64 (GB10) build of infra/docker/Dockerfile.postgis.
#
# Why this file exists: infra/docker/Dockerfile.postgis is FROM
# postgis/postgis:17-3.5, which publishes no linux/arm64 manifest (verified
# on this GB10: `docker build` of that Dockerfile fails with "no match for
# platform in manifest"). This file reuses the recipe proven by
# services/embedding-service/tests/Dockerfile.migtest (image
# sahoshi-postgis-pgvector-migtest, built and running on this host): the
# pgvector/pgvector:pg16 base is multi-arch, and Debian's
# postgresql-16-postgis-3 + postgresql-16-pgrouting provide the same
# PostGIS + pgRouting + pgvector extension stack the migrations require.
# The migrations contain no PG17-specific syntax (Dockerfile.migtest
# header documents the same verification).
# The base is pinned by digest: the pgvector/pgvector:pg16 build every existing
# sahoshi-vvip-postgis:arm64 / sahoshi-postgis:arm64 image on this host was
# built from (its layers are that image's base). A floating tag would hand a
# rebuild a newer base and recreate the store container. The two apt packages
# below still resolve at build time (Debian/PGDG drop superseded versions, so
# an exact pin would break the build); scripts/sahoshi_up.sh --build never
# rebuilds this image unless --rebuild-postgis is given.
FROM pgvector/pgvector:pg16@sha256:ccc6e83d6e35e931dc7c5def2022729d5a6c370318d099181995567ff1fb4d6b

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16-postgis-3 \
    postgresql-16-pgrouting \
 && rm -rf /var/lib/apt/lists/*
