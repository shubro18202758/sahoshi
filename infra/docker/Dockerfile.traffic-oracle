# Build traffic-oracle Python service
# Dependencies come entirely from services/traffic-oracle/pyproject.toml,
# including the adaptive-stream additions (httpx, gymnasium, pyyaml —
# plan C10), so this image rebuild picks them up with no Dockerfile edit.
# Base and tool images are pinned by digest (python 3.12.15-slim, uv 0.13.5) so a
# rebuild is reproducible; bump them deliberately, never by a floating tag.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS base

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml ./

# Install dependencies with uv (much faster than pip)
RUN uv pip install --system --no-cache -r pyproject.toml

COPY src/ src/

# sahoshi_models.yaml is models-owned and mounted at runtime; gpu_arbiter
# reads the unified-memory budget from it when present (env
# SAHOSHI_MODELS_CONFIG overrides the path), else /proc/meminfo.
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
CMD ["python", "-m", "traffic_oracle"]
