# Build the forecast (corridor forecasting) Python service — aarch64 (GB10, CUDA 13) first.
# Build context: services/forecast (compose: context ../services/forecast).
#
# The service runs Chronos-2 (amazon/chronos-2, Apache-2.0, ~120 M parameters) on the GPU and TimesFM 2.5
# (google/timesfm-2.5-200m-pytorch, Apache-2.0) for the backtest. torch comes from the PyTorch CUDA 13.0
# wheel index, which publishes linux-aarch64 (sbsa) wheels; everything else from PyPI via pyproject.toml
# (base deps + the `model` and `contender` extras). Without a GPU the same image runs on the CPU (slower).
#
# Weights are NOT baked in and NOT downloaded at run time: compose mounts the host's Hugging Face cache
# read-only and sets HF_HUB_OFFLINE=1 (run `huggingface-cli download amazon/chronos-2` and
# `… google/timesfm-2.5-200m-pytorch` once on the host).
# Base and tool images are pinned by digest (python 3.12.15-slim, uv 0.13.5), as for the other services.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS base

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml ./
RUN uv pip install --system --no-cache --index-url https://download.pytorch.org/whl/cu130 "torch>=2.9" \
 && uv pip install --system --no-cache -r pyproject.toml --extra model --extra contender

COPY src/ src/

RUN chmod -R a+rX /app \
 && python -m compileall -q /app/src \
 && useradd --system --uid 10020 --create-home --home-dir /home/forecast --shell /usr/sbin/nologin forecast
USER forecast

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV HF_HOME=/home/forecast/.cache/huggingface
ENV HF_HUB_OFFLINE=1
# Binds 127.0.0.1:8195 by default (config.py; HOST/PORT env override).
EXPOSE 8195
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','8195'), timeout=4)"
CMD ["python", "-m", "forecast"]
