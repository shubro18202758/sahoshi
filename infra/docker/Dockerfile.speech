# Build the speech service (Bengali ASR + TTS; ai-media stream).
# Build context: services/speech (compose: context ../services/speech).
# Dependencies come from services/speech/pyproject.toml plus the [models]
# extra; torch comes from the PyTorch CUDA 13.0 index (linux/arm64 wheels for
# the GB10). Base and tool images are pinned by digest (python 3.12.15-slim,
# uv 0.13.5), the same pins as the other Python services.
#
# Weights are NOT baked in: compose mounts the host's Hugging Face cache
# read-only at /hf and sets HF_HUB_OFFLINE=1, so the container never
# downloads anything at run time.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS base

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv

# ffmpeg decodes browser recordings (webm/ogg) over pipes; nothing touches disk.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./

RUN uv pip install --system --no-cache --index-url https://download.pytorch.org/whl/cu130 "torch>=2.8" \
 && uv pip install --system --no-cache -r pyproject.toml --extra models

COPY src/ src/

RUN chmod -R a+rX /app \
 && useradd --system --uid 10011 --no-create-home speech \
 && mkdir -p /cache/tts && chown speech /cache/tts
USER speech

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HF_HOME=/hf \
    HF_HUB_OFFLINE=1 \
    SPEECH_TTS_CACHE_DIR=/cache/tts \
    SPEECH_CITY_DIR=/app/cities/kolkata
# Binds SPEECH_HOST:SPEECH_PORT (default 127.0.0.1:8194; compose publishes it on loopback only).
EXPOSE 8194
CMD ["python", "-m", "speech_service"]
