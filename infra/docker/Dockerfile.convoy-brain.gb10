# Build convoy-brain Python service — GB10/arm64 variant.
#
# Same dependency set as Dockerfile.convoy-brain, but mirrors the repo's
# directory tree inside the image. Why: convoy_brain/config.py computes
# _REPO_ROOT = _PACKAGE_DIR.parents[4] (src/convoy_brain -> convoy-brain ->
# services -> VVIP -> repo root) to locate VVIP/models/configs/
# sahoshi_models.yaml. With the original WORKDIR /app layout parents[4] doesn't
# exist and the container dies at import (IndexError, observed on this
# host). Building at /repo/VVIP/services/convoy-brain fixes the arithmetic;
# every URL from that yaml is overridden by compose env anyway
# (MODEL_HOST_URL / LLAMA_BASE_URL / EMBEDDING_SERVICE_URL /
# TRAFFIC_ORACLE_URL / VVIP_VALKEY_URL), so the yaml itself is not copied.
# Base and tool images are pinned by digest (python 3.12.15-slim, uv 0.13.5) so a
# rebuild is reproducible; bump them deliberately, never by a floating tag.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS base

COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /usr/local/bin/uv

WORKDIR /repo/VVIP/services/convoy-brain

COPY services/convoy-brain/pyproject.toml ./

RUN uv pip install --system --no-cache -r pyproject.toml

COPY services/convoy-brain/src/ src/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/repo/VVIP/services/convoy-brain/src

# Non-root runtime (uid 10005). COPY keeps the checkout's mode bits and POSIX
# ACLs (0640/2750 on this host, other::---): make the tree world-readable,
# byte-compile it while still root, and give the user a writable HOME for
# any library cache. The brain writes no file (no volume, no host path).
RUN chmod -R a+rX /repo/VVIP \
 && python -m compileall -q /repo/VVIP/services \
 && useradd --system --uid 10005 --create-home --home-dir /home/brain \
        --shell /usr/sbin/nologin brain
USER brain
CMD ["python", "-m", "convoy_brain"]
