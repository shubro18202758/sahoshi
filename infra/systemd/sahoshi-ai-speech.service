# Sahoshi AI tier — Bengali voice: field reports and spoken advisories (GPU, lazy) on 127.0.0.1:8194.
# Runs from the checkout's src with a host venv ($SAHOSHI_AI_VENV_DIR/ai-media, default $SAHOSHI_ROOT/.venvs/ai-media;
# see services/speech/README.md for how to build it). Loopback only; the deck proxies /api/speech.
# Pulled in by sahoshi-ai.target. Values come from ~/.config/sahoshi/sahoshi.env.
[Unit]
Description=Sahoshi AI: Bengali voice: field reports and spoken advisories (GPU, lazy) on 127.0.0.1:8194
PartOf=sahoshi-ai.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/sahoshi/sahoshi.env
ExecStart=/bin/bash -c 'cd "$SAHOSHI_ROOT/services/speech" && exec env PYTHONPATH=src SPEECH_PORT=8194 SPEECH_HOST=127.0.0.1 SPEECH_TTS_LLM_PORT=8202 HF_HUB_OFFLINE=1 "$${SAHOSHI_AI_VENV_DIR:-$SAHOSHI_ROOT/.venvs}/ai-media/bin/python" -m speech_service'
Restart=always
RestartSec=5
TimeoutStopSec=30
# shared GB10 unified pool: an AI host is the kernel's preferred OOM victim, never the desktop session
OOMScoreAdjust=500
