# Sahoshi AI tier — road state from a camera still: roads and vehicles only (GPU, lazy) on 127.0.0.1:8196.
# Runs from the checkout's src with a host venv ($SAHOSHI_AI_VENV_DIR/ai-media, default $SAHOSHI_ROOT/.venvs/ai-media;
# see services/vision/README.md for how to build it). Loopback only; the deck proxies /api/vision.
# Pulled in by sahoshi-ai.target. Values come from ~/.config/sahoshi/sahoshi.env.
[Unit]
Description=Sahoshi AI: road state from a camera still: roads and vehicles only (GPU, lazy) on 127.0.0.1:8196
PartOf=sahoshi-ai.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/sahoshi/sahoshi.env
ExecStart=/bin/bash -c 'cd "$SAHOSHI_ROOT/services/vision" && exec env PYTHONPATH=src VISION_PORT=8196 VISION_HOST=127.0.0.1 VISION_LLM_PORT=8201 "$${SAHOSHI_AI_VENV_DIR:-$SAHOSHI_ROOT/.venvs}/ai-media/bin/python" -m vision_service'
Restart=always
RestartSec=5
TimeoutStopSec=30
# shared GB10 unified pool: an AI host is the kernel's preferred OOM victim, never the desktop session
OOMScoreAdjust=500
