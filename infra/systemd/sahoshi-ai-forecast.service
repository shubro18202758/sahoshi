# Sahoshi AI tier — corridor forecasting (Chronos-2, GPU, lazy) on 127.0.0.1:8195.
# Runs from the checkout's src with a host venv ($SAHOSHI_AI_VENV_DIR/ai-forecast, default $SAHOSHI_ROOT/.venvs/ai-forecast;
# see services/forecast/README.md for how to build it). Loopback only; the deck proxies /api/forecast.
# Pulled in by sahoshi-ai.target. Values come from ~/.config/sahoshi/sahoshi.env.
[Unit]
Description=Sahoshi AI: corridor forecasting (Chronos-2, GPU, lazy) on 127.0.0.1:8195
PartOf=sahoshi-ai.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/sahoshi/sahoshi.env
ExecStart=/bin/bash -c 'cd "$SAHOSHI_ROOT/services/forecast" && exec env PYTHONPATH=src PORT=8195 HOST=127.0.0.1 SAHOSHI_FORECAST_ORACLE_URL=http://127.0.0.1:8191 HF_HUB_OFFLINE=1 "$${SAHOSHI_AI_VENV_DIR:-$SAHOSHI_ROOT/.venvs}/ai-forecast/bin/python" -m forecast'
Restart=always
RestartSec=5
TimeoutStopSec=30
# shared GB10 unified pool: an AI host is the kernel's preferred OOM victim, never the desktop session
OOMScoreAdjust=500
