# Sahoshi AI tier — open Kolkata city feeds (air quality, heat, GDACS cyclones, CWC rivers, USGS quakes, KMC notices) on 127.0.0.1:8199.
# Runs from the checkout's src with a host venv ($SAHOSHI_AI_VENV_DIR/ai-forecast, default $SAHOSHI_ROOT/.venvs/ai-forecast:
# fastapi, uvicorn, httpx, pydantic-settings, structlog — everything services/cityfeeds needs; see its README).
# Loopback only; the deck proxies /api/cityfeeds. Polite: every feed has a cache, a minimum interval and a daily cap.
# Pulled in by sahoshi-ai.target. Values come from ~/.config/sahoshi/sahoshi.env (SAHOSHI_FEEDS_* overrides, none secret).
[Unit]
Description=Sahoshi city feeds (air, heat, cyclones, rivers, quakes, notices) on 127.0.0.1:8199
PartOf=sahoshi-ai.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/sahoshi/sahoshi.env
ExecStart=/bin/bash -c 'cd "$SAHOSHI_ROOT/services/cityfeeds" && exec env PYTHONPATH=src PORT=8199 HOST=127.0.0.1 "$${SAHOSHI_AI_VENV_DIR:-$SAHOSHI_ROOT/.venvs}/ai-forecast/bin/python" -m cityfeeds'
Restart=always
RestartSec=5
TimeoutStopSec=30
# shared GB10 unified pool: an AI host is the kernel's preferred OOM victim, never the desktop session
OOMScoreAdjust=500
